# Copy to .env and adjust. Do not commit .env.
# Local development credentials only. Change them outside a private workstation.

DATABASE_URL=postgresql+psycopg://sentinellog:sentinellog@127.0.0.1:5432/sentinellog

# Optional. Applied only as the default year for a newly created log source
# when the request does not set one. Never inferred from log text.
# These syslog lines have no timezone; a configured year is stored as UTC.
# Leave this unset for arbitrary sources. import-bundled sets 2005 on the
# Linux_2k dataset only; that default is not this setting.
# SOURCE_YEAR=

# Reject uploads larger than this many bytes (default 32 MiB).
MAX_UPLOAD_BYTES=33554432

LOG_LEVEL=INFO

# Comma-separated browser origins. The default is the local Vite dev server.
# A wildcard is rejected. Leave empty to disable cross-origin browser access.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# In-process limit per client for import, detection, anomaly train/score, risk train, and PDF export.
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# When false, unhandled errors are JSON and do not include a stack trace.
DEBUG=false

# Directory for Isolation Forest artifacts. Relative paths are under the repo root.
# ANOMALY_ARTIFACT_DIR=var/anomaly-models
# RISK_ARTIFACT_DIR=var/risk-models

# Used by pytest. The test suite truncates this database.
SENTINELLOG_TEST_DATABASE_URL=postgresql+psycopg://sentinellog:sentinellog@127.0.0.1:5432/sentinellog_test
